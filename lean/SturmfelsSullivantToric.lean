/-
# The Sturmfels–Sullivant conjecture (OPEN), stated on atlas-lean's toric ideals

This file restates the conjecture of `SturmfelsSullivant.lean` ideal-theoretically, on top of
`MathlibExt.RingTheory.ToricIdeal` / `MarkovBasis` from facebookresearch/atlas-lean
(Diaconis–Sturmfels: moves form a Markov basis iff their binomials generate the toric ideal),
and proves that the ideal-theoretic and the combinatorial formulations are equivalent.

Objects.
* `Flow n G`       : `n`-tuples in `G` summing to zero (the variables `q_f` of the model).
* `flowStat`       : `f ↦ ∑ i, e_(i, f i) ∈ ℕ^([n] × G)`, the vertices of Michałek's polytope `P_{n,G}`.
* `phyloIdeal k`   : `toricIdeal k flowStat`, the ideal of the group-based model on the claw `K_{1,n}`.
* `lowMove d`      : lattice moves whose positive and negative parts have at most `d` flows.
* `IdealGeneratedInDegree k d` : the binomials of the moves of degree `≤ d` generate `phyloIdeal k`.
* `GeneratedInDegree d` : Michałek's combinatorial form (exchange `≤ d` flows by a compatible
  multiset), as in `SturmfelsSullivant.lean`, with the exchanged multisets both of size `≤ d`.

Results.
* `idealGeneratedInDegree_iff_isMarkovBasis` : instance of the atlas-lean theorem.
* `isMarkovBasis_iff_generatedInDegree`       : Markov-basis form ↔ multiset-exchange form.
* `idealGeneratedInDegree_iff`                : ideal form ↔ combinatorial form, for every field;
  in particular the ideal-theoretic statement does not depend on the field.
* `not_idealGeneratedInDegree_two_zmod3`      : over every field, the ideal for `ℤ/3` on three
  leaves is **not** generated by binomials of degree `≤ 2` (non-vacuity).
* `SturmfelsSullivantConjecture`              : the open statement, over `ℂ`.

Remark on "generated in degree `≤ d`". A toric ideal is homogeneous here and spanned by binomials,
so "generated in degree `≤ d`" is taken to mean "generated by its binomials `x^{f⁺} - x^{f⁻}` of
degree `≤ d`".  That this agrees with "generated by all its elements of degree `≤ d`" is standard
but is not proved in this file.
-/
import Mathlib
import MathlibExt.RingTheory.MarkovBasis

open MvPolynomial MathlibExt.RingTheory.ToricIdeal MathlibExt.RingTheory.MarkovBasis

namespace PhyloToric

variable (n : ℕ) (G : Type*) [AddCommGroup G]

/-- A group-based flow on `n` leaves. -/
def Flow : Type _ := {f : Fin n → G // ∑ i, f i = 0}

variable {n G}

/-- The vertex of the polytope `P_{n,G}` attached to a flow: `∑ i, e_(i, f i)`. -/
noncomputable def flowStat (f : Flow n G) : (Fin n × G) →₀ ℕ :=
  ∑ i, Finsupp.single (i, f.1 i) 1

variable (n G) in
/-- The ideal of the group-based model for `G` on the claw tree `K_{1,n}` (Fourier coordinates). -/
noncomputable def phyloIdeal (k : Type*) [Field k] : Ideal (MvPolynomial (Flow n G) k) :=
  toricIdeal k (flowStat (n := n) (G := G))

/-- Number of flows in a table of counts. -/
noncomputable def size (g : Flow n G →₀ ℕ) : ℕ := Multiset.card (Finsupp.toMultiset g)

variable (n G) in
/-- Lattice moves of degree at most `d`. -/
def LowMove (d : ℕ) : Type _ :=
  {f : Flow n G →₀ ℤ // Finsupp.linearCombination ℤ (statInt (flowStat (n := n) (G := G))) f = 0 ∧
    size (posPartNat f) ≤ d ∧ size (negPartNat f) ≤ d}

/-- The underlying integer vector of a low-degree move. -/
def lowMove (d : ℕ) : LowMove n G d → (Flow n G →₀ ℤ) := Subtype.val

variable (n G) in
/-- The ideal of the model is generated by its binomials of degree `≤ d`. -/
def IdealGeneratedInDegree (k : Type*) [Field k] (d : ℕ) : Prop :=
  Ideal.span (Set.range fun i : LowMove n G d => moveBinomial k (lowMove d i)) = phyloIdeal n G k

/-- **Sturmfels–Sullivant conjecture** (open), ideal-theoretic form over `ℂ`. -/
def SturmfelsSullivantConjecture : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Fintype G] (n : ℕ), IdealGeneratedInDegree n G ℂ (Fintype.card G)

/-- Instance of Diaconis–Sturmfels (atlas-lean): generation by low-degree binomials is the same as
low-degree moves connecting every fibre. -/
theorem idealGeneratedInDegree_iff_isMarkovBasis (k : Type*) [Field k] (d : ℕ) :
    IdealGeneratedInDegree n G k d ↔ IsMarkovBasis (flowStat (n := n) (G := G)) (lowMove d) :=
  (isMarkovBasis_iff_span_eq_toricIdeal k _ _).symm

/-! ## Combinatorial form -/

/-- Two multisets of flows are compatible if they have the same entries at every leaf. -/
def Compatible (M₁ M₂ : Multiset (Flow n G)) : Prop :=
  ∀ i : Fin n, M₁.map (fun f => f.1 i) = M₂.map (fun f => f.1 i)

/-- Exchange a sub-multiset `A` by a compatible multiset `B`, both with at most `d` flows. -/
def Step (d : ℕ) (M M' : Multiset (Flow n G)) : Prop :=
  ∃ A B C : Multiset (Flow n G), M = A + C ∧ M' = B + C ∧ Multiset.card A ≤ d ∧
    Multiset.card B ≤ d ∧ Compatible A B

variable (n G) in
/-- Michałek's combinatorial form of "generated in degree `≤ d`". -/
def GeneratedInDegree (d : ℕ) : Prop :=
  ∀ M₁ M₂ : Multiset (Flow n G), Compatible M₁ M₂ → Relation.ReflTransGen (Step d) M₁ M₂

section bridge
open Classical

/-- The statistic of a table counts, at `(i, x)`, the flows whose `i`-th entry is `x`. -/
lemma statistic_apply (g : Flow n G →₀ ℕ) (i : Fin n) (x : G) :
    statistic (flowStat (n := n) (G := G)) g (i, x)
      = Multiset.count x ((Finsupp.toMultiset g).map (fun f => f.1 i)) := by
  induction g using Finsupp.induction_linear with
  | zero => simp
  | add g h hg hh => simp [map_add, hg, hh]
  | single f m =>
    simp only [statistic, Finsupp.linearCombination_single, Finsupp.toMultiset_single,
      Multiset.map_nsmul, Multiset.map_singleton, Multiset.count_nsmul, Finsupp.smul_apply,
      smul_eq_mul, flowStat, Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply,
      Prod.mk.injEq, Multiset.count_singleton]
    congr 1
    rw [Finset.sum_eq_single i]
    · simp [eq_comm]
    · intro j _ hji; simp [hji]
    · simp

/-- Equal statistic is the same as compatibility. -/
lemma statistic_eq_iff_compatible (g h : Flow n G →₀ ℕ) :
    statistic (flowStat (n := n) (G := G)) g = statistic flowStat h
      ↔ Compatible (Finsupp.toMultiset g) (Finsupp.toMultiset h) := by
  constructor
  · intro e i
    ext x
    rw [← statistic_apply, ← statistic_apply, e]
  · intro hc
    ext ⟨i, x⟩
    rw [statistic_apply, statistic_apply, hc i]

lemma toInt_apply (g : Flow n G →₀ ℕ) (x : Flow n G) : toInt g x = (g x : ℤ) := by
  simp [toInt]

lemma posPartNat_apply (f : Flow n G →₀ ℤ) (x : Flow n G) : posPartNat f x = (f x).toNat := by
  simp [posPartNat]

lemma negPartNat_apply (f : Flow n G →₀ ℤ) (x : Flow n G) : negPartNat f x = (-f x).toNat := by
  simp [negPartNat]

/-- A step of the low-degree move chain is an exchange step. -/
lemma step_of_moveStep {d : ℕ} {g h : Flow n G →₀ ℕ} (hs : MoveStep (lowMove (n := n) (G := G) d) g h) :
    Step d (Finsupp.toMultiset g) (Finsupp.toMultiset h) := by
  obtain ⟨⟨f, hlat, hp, hq⟩, ε, hε, he⟩ := hs
  have hstat := (linearCombination_eq_zero_iff (flowStat (n := n) (G := G)) f).1 hlat
  have hpt : ∀ x, (h x : ℤ) = g x + ε * f x := by
    intro x
    have := congrArg (fun F => F x) he
    simpa [toInt_apply, lowMove] using this
  rcases hε with rfl | rfl
  · -- `g = f⁻ + c`, `h = f⁺ + c`
    refine ⟨Finsupp.toMultiset (negPartNat f), Finsupp.toMultiset (posPartNat f),
      Finsupp.toMultiset (g - negPartNat f), ?_, ?_, hq, hp,
      (statistic_eq_iff_compatible _ _).1 hstat.symm⟩
    · rw [← map_add]; congr 1; ext x
      have := hpt x
      simp only [Finsupp.add_apply, Finsupp.tsub_apply, negPartNat_apply]
      omega
    · rw [← map_add]; congr 1; ext x
      have := hpt x
      simp only [Finsupp.add_apply, Finsupp.tsub_apply, negPartNat_apply, posPartNat_apply]
      omega
  · -- `g = f⁺ + c`, `h = f⁻ + c`
    refine ⟨Finsupp.toMultiset (posPartNat f), Finsupp.toMultiset (negPartNat f),
      Finsupp.toMultiset (g - posPartNat f), ?_, ?_, hp, hq,
      (statistic_eq_iff_compatible _ _).1 hstat⟩
    · rw [← map_add]; congr 1; ext x
      have := hpt x
      simp only [Finsupp.add_apply, Finsupp.tsub_apply, posPartNat_apply]
      omega
    · rw [← map_add]; congr 1; ext x
      have := hpt x
      simp only [Finsupp.add_apply, Finsupp.tsub_apply, negPartNat_apply, posPartNat_apply]
      omega

lemma size_le_of_le {a b : Flow n G →₀ ℕ} (h : ∀ x, a x ≤ b x) : size a ≤ size b := by
  have : b = a + (b - a) := by
    ext x; simp only [Finsupp.add_apply, Finsupp.tsub_apply]; have := h x; omega
  unfold size
  rw [this, map_add, Multiset.card_add]
  exact Nat.le_add_right _ _

/-- An exchange step is a step of the low-degree move chain. -/
lemma moveStep_of_step {d : ℕ} {M M' : Multiset (Flow n G)} (hs : Step d M M') :
    MoveStep (lowMove (n := n) (G := G) d) (Multiset.toFinsupp M) (Multiset.toFinsupp M') := by
  obtain ⟨A, B, C, rfl, rfl, hA, hB, hAB⟩ := hs
  set a := Multiset.toFinsupp A with ha
  set b := Multiset.toFinsupp B with hb
  set c := Multiset.toFinsupp C with hc
  have hstat : statistic (flowStat (n := n) (G := G)) a = statistic flowStat b := by
    rw [statistic_eq_iff_compatible]; simpa [ha, hb] using hAB
  let f : Flow n G →₀ ℤ := toInt b - toInt a
  have hpos : posPartNat f = b - a := by
    ext x; simp only [posPartNat_apply, f, Finsupp.sub_apply, toInt_apply, Finsupp.tsub_apply]; omega
  have hneg : negPartNat f = a - b := by
    ext x; simp only [negPartNat_apply, f, Finsupp.sub_apply, toInt_apply, Finsupp.tsub_apply]; omega
  have hlat : Finsupp.linearCombination ℤ (statInt (flowStat (n := n) (G := G))) f = 0 := by
    rw [linearCombination_eq_zero_iff, hpos, hneg]
    have e : b + (a - b) = a + (b - a) := by
      ext x; simp only [Finsupp.add_apply, Finsupp.tsub_apply]; omega
    have e' := congrArg (statistic (flowStat (n := n) (G := G))) e
    rw [map_add, map_add, hstat] at e'
    exact (add_left_cancel e').symm
  have hsa : size a ≤ d := by simpa [size, ha] using hA
  have hsb : size b ≤ d := by simpa [size, hb] using hB
  have hp : size (posPartNat f) ≤ d := by
    rw [hpos]; exact (size_le_of_le fun x => by simp).trans hsb
  have hq : size (negPartNat f) ≤ d := by
    rw [hneg]; exact (size_le_of_le fun x => by simp).trans hsa
  refine ⟨⟨f, hlat, hp, hq⟩, 1, Or.inl rfl, ?_⟩
  ext x
  simp only [lowMove, one_smul, Finsupp.add_apply, toInt_apply, f, Finsupp.sub_apply,
    Multiset.toFinsupp_add, ← ha, ← hb, ← hc]
  push_cast
  ring

private lemma reflTransGen_map {α β : Type*} {r : α → α → Prop} {p : β → β → Prop} (F : α → β)
    (h : ∀ a b, r a b → p (F a) (F b)) {a b : α} (hab : Relation.ReflTransGen r a b) :
    Relation.ReflTransGen p (F a) (F b) := by
  induction hab with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hs ih => exact ih.tail (h _ _ hs)

/-- **Markov-basis form ↔ multiset-exchange form.** -/
theorem isMarkovBasis_iff_generatedInDegree (d : ℕ) :
    IsMarkovBasis (flowStat (n := n) (G := G)) (lowMove d) ↔ GeneratedInDegree n G d := by
  constructor
  · rintro ⟨-, hconn⟩ M₁ M₂ hc
    have hst : statistic (flowStat (n := n) (G := G)) (Multiset.toFinsupp M₁)
        = statistic flowStat (Multiset.toFinsupp M₂) := by
      rw [statistic_eq_iff_compatible]; simpa using hc
    have := reflTransGen_map (r := MoveStep (lowMove (n := n) (G := G) d))
      (p := Step d) Finsupp.toMultiset (fun _ _ h => step_of_moveStep h) (hconn _ _ hst)
    simpa using this
  · intro hgen
    refine ⟨fun i => i.2.1, fun g g' hst => ?_⟩
    have hc := (statistic_eq_iff_compatible g g').1 hst
    have := reflTransGen_map (r := Step (n := n) (G := G) d)
      (p := MoveStep (lowMove d)) Multiset.toFinsupp (fun _ _ h => moveStep_of_step h)
      (hgen _ _ hc)
    simpa using this

/-- **Ideal form ↔ combinatorial form**, over any field. -/
theorem idealGeneratedInDegree_iff (k : Type*) [Field k] (d : ℕ) :
    IdealGeneratedInDegree n G k d ↔ GeneratedInDegree n G d :=
  (idealGeneratedInDegree_iff_isMarkovBasis k d).trans (isMarkovBasis_iff_generatedInDegree d)

/-- The conjecture in combinatorial form. -/
theorem sturmfelsSullivantConjecture_iff :
    SturmfelsSullivantConjecture ↔
      ∀ (G : Type) [AddCommGroup G] [Fintype G] (n : ℕ), GeneratedInDegree n G (Fintype.card G) := by
  unfold SturmfelsSullivantConjecture
  constructor
  · intro h G _ _ n; exact (idealGeneratedInDegree_iff ℂ _).1 (h G n)
  · intro h G _ _ n; exact (idealGeneratedInDegree_iff ℂ _).2 (h G n)

end bridge

/-! ## Sanity checks -/

/-- Compatible multisets have the same number of flows (for `n ≥ 1`). -/
lemma Compatible.card_eq {M₁ M₂ : Multiset (Flow n G)} (h : Compatible M₁ M₂) (i : Fin n) :
    Multiset.card M₁ = Multiset.card M₂ := by
  have := congrArg Multiset.card (h i)
  simpa using this

/-- The conjecture holds for the trivial group (all flows coincide), for `n ≥ 1`. -/
theorem generatedInDegree_of_subsingleton [Subsingleton G] (hn : 0 < n) (d : ℕ) :
    GeneratedInDegree n G d := by
  intro M₁ M₂ hc
  have : Subsingleton (Flow n G) := ⟨fun f g => Subtype.ext (funext fun i => Subsingleton.elim _ _)⟩
  have hcard := hc.card_eq ⟨0, hn⟩
  have : M₁ = M₂ := by
    rcases Multiset.empty_or_exists_mem M₁ with h0 | ⟨a, -⟩
    · subst h0
      exact (Multiset.card_eq_zero.mp (by simpa using hcard.symm)).symm
    · have e₁ : M₁ = Multiset.replicate (Multiset.card M₁) a :=
        Multiset.eq_replicate_card.mpr fun b _ => Subsingleton.elim b a
      have e₂ : M₂ = Multiset.replicate (Multiset.card M₂) a :=
        Multiset.eq_replicate_card.mpr fun b _ => Subsingleton.elim b a
      rw [e₁, e₂, hcard]
  rw [this]

/-! ### `ℤ/3` on three leaves needs a cubic -/

/-- The constant flow `(g, g, g)` over `ℤ/3`. -/
def constFlow (g : ZMod 3) : Flow 3 (ZMod 3) :=
  ⟨fun _ => g, by simp [Fin.sum_univ_three]; revert g; decide⟩

/-- The flow `(a, b, c)` over `ℤ/3` (requires `a + b + c = 0`). -/
def mkFlow (a b c : ZMod 3) (h : a + b + c = 0) : Flow 3 (ZMod 3) :=
  ⟨![a, b, c], by simpa [Fin.sum_univ_three] using h⟩

/-- `{000, 111, 222}`. -/
def M₁ : Multiset (Flow 3 (ZMod 3)) := {constFlow 0, constFlow 1, constFlow 2}

/-- `{012, 120, 201}`. -/
def M₂ : Multiset (Flow 3 (ZMod 3)) :=
  {mkFlow 0 1 2 (by decide), mkFlow 1 2 0 (by decide), mkFlow 2 0 1 (by decide)}

/-- The two multisets are compatible: this is the cubic invariant
`q₀₀₀ q₁₁₁ q₂₂₂ = q₀₁₂ q₁₂₀ q₂₀₁`. -/
lemma M₁_M₂_compatible : Compatible M₁ M₂ := by
  intro i
  fin_cases i <;> simp [M₁, M₂, constFlow, mkFlow] <;> decide

private lemma zmod3_const : ∀ x y z : ZMod 3, x + y + z = 0 → (x = y ∨ y = z ∨ x = z) →
    x = y ∧ y = z := by decide

/-- A flow over `ℤ/3` on three leaves whose entries take at most two values is constant. -/
private lemma flow_const_of_two_values (f : Flow 3 (ZMod 3)) (S : Finset (ZMod 3))
    (hS : S.card ≤ 2) (hf : ∀ i, f.1 i ∈ S) : f = constFlow (f.1 0) := by
  have hsum : f.1 0 + f.1 1 + f.1 2 = 0 := by
    have := f.2; rwa [Fin.sum_univ_three] at this
  obtain ⟨i, -, j, -, hij, heq⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to
    (s := (Finset.univ : Finset (Fin 3))) (t := S) (f := f.1) (by simpa using Nat.lt_succ_of_le hS)
    (fun i _ => hf i)
  have h3 : f.1 0 = f.1 1 ∨ f.1 1 = f.1 2 ∨ f.1 0 = f.1 2 := by
    fin_cases i <;> fin_cases j <;> simp_all <;> tauto
  obtain ⟨h01, h12⟩ := zmod3_const _ _ _ hsum h3
  apply Subtype.ext
  funext k
  fin_cases k
  · rfl
  · exact h01.symm
  · exact (h01.trans h12).symm

/-- From `{000, 111, 222}` no exchange of at most two flows leads anywhere else. -/
private lemma step_two_M₁ {M' : Multiset (Flow 3 (ZMod 3))} (h : Step 2 M₁ M') : M' = M₁ := by
  obtain ⟨A, B, C, hM, rfl, hcard, -, hAB⟩ := h
  have hA : ∀ a ∈ A, a = constFlow (a.1 0) := by
    intro a ha
    have : a ∈ M₁ := by rw [hM]; exact Multiset.mem_add.mpr (Or.inl ha)
    simp only [M₁, Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at this
    rcases this with rfl | rfl | rfl <;> rfl
  classical
  set S : Finset (ZMod 3) := (A.map (fun a => a.1 0)).toFinset with hSdef
  have hScard : S.card ≤ 2 :=
    (Multiset.toFinset_card_le _).trans (by simpa using hcard)
  have hB : ∀ b ∈ B, b = constFlow (b.1 0) := by
    intro b hb
    refine flow_const_of_two_values b S hScard fun i => ?_
    have : b.1 i ∈ B.map (fun f => f.1 i) := Multiset.mem_map_of_mem _ hb
    rw [← hAB i] at this
    obtain ⟨a, ha, hai⟩ := Multiset.mem_map.mp this
    rw [hSdef, Multiset.mem_toFinset]
    refine Multiset.mem_map.mpr ⟨a, ha, ?_⟩
    rw [← hai, hA a ha]; rfl
  have eA : A = (A.map (fun a => a.1 0)).map constFlow := by
    rw [Multiset.map_map]
    conv_lhs => rw [← Multiset.map_id A]
    exact Multiset.map_congr rfl fun a ha => hA a ha
  have eB : B = (B.map (fun a => a.1 0)).map constFlow := by
    rw [Multiset.map_map]
    conv_lhs => rw [← Multiset.map_id B]
    exact Multiset.map_congr rfl fun b hb => hB b hb
  rw [hM, eA, eB, hAB 0]

/-- **`ℤ/3` on the claw `K_{1,3}` is not generated in degree 2**: the definitions are not
vacuous, and together with Michałek's theorem the bound `|G| = 3` is attained. -/
theorem not_generatedInDegree_two_zmod3 : ¬ GeneratedInDegree 3 (ZMod 3) 2 := by
  intro h
  have hreach := h M₁ M₂ M₁_M₂_compatible
  have hstay : ∀ M, Relation.ReflTransGen (Step 2) M₁ M → M = M₁ := by
    intro M hM
    induction hM with
    | refl => rfl
    | tail _ hs ih => rw [ih] at hs; exact step_two_M₁ hs
  have heq : M₂ = M₁ := hstay _ hreach
  have hmem : mkFlow 0 1 2 (by decide) ∈ M₁ := by rw [← heq]; simp [M₂]
  simp only [M₁, Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hmem
  have key : ∀ g : ZMod 3, mkFlow 0 1 2 (by decide) ≠ constFlow g := by
    intro g hg
    have h0 := congrArg (fun f : Flow 3 (ZMod 3) => f.1 0) hg
    have h1 := congrArg (fun f : Flow 3 (ZMod 3) => f.1 1) hg
    simp [mkFlow, constFlow] at h0 h1
    rw [← h0] at h1
    exact absurd h1 (by decide)
  rcases hmem with h | h | h <;> exact key _ h

/-- **Non-vacuity, ideal-theoretic.** Over every field, the ideal of the `ℤ/3` model on the claw
`K_{1,3}` is not generated by its binomials of degree `≤ 2`. -/
theorem not_idealGeneratedInDegree_two_zmod3 (k : Type*) [Field k] :
    ¬ IdealGeneratedInDegree 3 (ZMod 3) k 2 :=
  fun h => not_generatedInDegree_two_zmod3 ((idealGeneratedInDegree_iff k 2).1 h)

/-- The conjecture holds for the trivial group, ideal-theoretically, over every field. -/
theorem idealGeneratedInDegree_of_subsingleton [Subsingleton G] (hn : 0 < n) (k : Type*) [Field k]
    (d : ℕ) : IdealGeneratedInDegree n G k d :=
  (idealGeneratedInDegree_iff k d).2 (generatedInDegree_of_subsingleton hn d)

open Classical in
/-- The cubic `q₀₀₀ q₁₁₁ q₂₂₂ - q₀₁₂ q₁₂₀ q₂₀₁` lies in the ideal (over every field). -/
theorem cubic_mem_phyloIdeal (k : Type*) [Field k] :
    monomial (Multiset.toFinsupp M₁) (1 : k) - monomial (Multiset.toFinsupp M₂) 1
      ∈ phyloIdeal 3 (ZMod 3) k := by
  classical
  rw [phyloIdeal, monomial_sub_monomial_mem_toricIdeal_iff, statistic_eq_iff_compatible]
  simpa using M₁_M₂_compatible

end PhyloToric

