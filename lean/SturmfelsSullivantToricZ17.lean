namespace Z17

abbrev K := ZMod 17 × ZMod 17

/-- Third entry of the flow encoded by a pair. -/
def thd (p : K) : ZMod 17 := -p.1 - p.2

/-- The 22 admissible row types. -/
def T : List K := [(1, 3), (1, 11), (1, 15), (7, 3), (7, 8), (7, 16), (8, 8), (8, 15), (10, 0), (10, 6), (10, 10), (10, 11), (11, 1), (11, 10), (11, 16), (14, 1), (14, 6), (14, 15), (15, 0), (15, 1), (15, 6), (15, 8)]

/-- Table `A` (18 rows). -/
