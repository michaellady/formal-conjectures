/-! ## Flows and the refutation -/

namespace SturmfelsSullivant

variable (n : ℕ) (G : Type*) [AddCommGroup G]

/-- A group-based flow on `n` leaves. -/
def Flow : Type _ := {f : Fin n → G // ∑ i, f i = 0}

variable {n G}

/-- Compatible multisets of flows: same entries at every leaf. -/
def Compatible (M₁ M₂ : Multiset (Flow n G)) : Prop :=
  ∀ i : Fin n, M₁.map (fun f => f.1 i) = M₂.map (fun f => f.1 i)

/-- Exchange a sub-multiset `A` of at most `d` flows by a compatible multiset `B`. -/
def Step (d : ℕ) (M M' : Multiset (Flow n G)) : Prop :=
  ∃ A B C : Multiset (Flow n G), M = A + C ∧ M' = B + C ∧ A.card ≤ d ∧ B.card ≤ d ∧
    Compatible A B

variable (n G) in
/-- Generated in degree `≤ d`, combinatorial form. -/
def GeneratedInDegree (d : ℕ) : Prop :=
  ∀ M₁ M₂ : Multiset (Flow n G), Compatible M₁ M₂ → Relation.ReflTransGen (Step d) M₁ M₂

lemma Step.compatible {d : ℕ} {M M' : Multiset (Flow n G)} (h : Step d M M') :
    Compatible M M' := by
  obtain ⟨A, B, C, rfl, rfl, -, -, hAB⟩ := h
  intro i
  rw [Multiset.map_add, Multiset.map_add, hAB i]

lemma compatible_of_reflTransGen {d : ℕ} {M M' : Multiset (Flow n G)}
    (h : Relation.ReflTransGen (Step d) M M') : Compatible M M' := by
  induction h with
  | refl => exact fun _ => rfl
  | tail _ hs ih => exact fun i => (ih i).trans (hs.compatible i)

/-! ## Monotonicity in the number of leaves -/

/-- Append a zero entry to a flow. -/
def ext (f : Flow n G) : Flow (n + 1) G :=
  ⟨Fin.snoc f.1 0, by rw [Fin.sum_univ_castSucc]; simp [f.2]⟩

@[simp] lemma ext_castSucc (f : Flow n G) (i : Fin n) : (ext f).1 i.castSucc = f.1 i := by
  simp [ext]

@[simp] lemma ext_last (f : Flow n G) : (ext f).1 (Fin.last n) = 0 := by simp [ext]

lemma ext_injective : Function.Injective (ext : Flow n G → Flow (n + 1) G) := by
  intro f g h
  apply Subtype.ext
  funext i
  have := congrArg (fun x : Flow (n + 1) G => x.1 i.castSucc) h
  simpa using this

open Classical in
/-- Drop the last entry of a flow whose last entry is zero (and send every other flow to `0`). -/
noncomputable def res (f : Flow (n + 1) G) : Flow n G :=
  if h : f.1 (Fin.last n) = 0 then
    ⟨fun i => f.1 i.castSucc, by
      have := f.2
      rw [Fin.sum_univ_castSucc, h, add_zero] at this
      exact this⟩
  else ⟨0, by simp⟩

lemma ext_res (f : Flow (n + 1) G) (h : f.1 (Fin.last n) = 0) : ext (res f) = f := by
  apply Subtype.ext
  funext i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · rw [ext_last, h]
  · rw [ext_castSucc]; simp [res, h]

lemma res_ext (f : Flow n G) : res (ext f) = f :=
  ext_injective (ext_res _ (ext_last f))

lemma map_ext_map_res (X : Multiset (Flow (n + 1) G)) (h : ∀ f ∈ X, f.1 (Fin.last n) = 0) :
    (X.map res).map ext = X := by
  rw [Multiset.map_map]
  conv_rhs => rw [← Multiset.map_id X]
  exact Multiset.map_congr rfl fun f hf => ext_res f (h f hf)

lemma map_res_map_ext (X : Multiset (Flow n G)) : (X.map ext).map res = X := by
  rw [Multiset.map_map]
  conv_rhs => rw [← Multiset.map_id X]
  exact Multiset.map_congr rfl fun f _ => res_ext f

lemma Compatible.map_ext (hn : 0 < n) {M₁ M₂ : Multiset (Flow n G)} (h : Compatible M₁ M₂) :
    Compatible (M₁.map ext) (M₂.map ext) := by
  have hcard : M₁.card = M₂.card := by simpa using congrArg Multiset.card (h ⟨0, hn⟩)
  intro i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · simp only [Multiset.map_map, Function.comp_def, ext_last, Multiset.map_const', hcard]
  · simp only [Multiset.map_map, Function.comp_def, ext_castSucc]
    exact h j

lemma Compatible.of_map_ext {X Y : Multiset (Flow n G)} (h : Compatible (X.map ext) (Y.map ext)) :
    Compatible X Y := by
  intro i
  have := h i.castSucc
  simpa only [Multiset.map_map, Function.comp_def, ext_castSucc] using this

lemma last_eq_zero_of_compatible {M : Multiset (Flow n G)} {Y : Multiset (Flow (n + 1) G)}
    (h : Compatible (M.map ext) Y) : ∀ f ∈ Y, f.1 (Fin.last n) = 0 := by
  intro f hf
  have : f.1 (Fin.last n) ∈ Y.map (fun g => g.1 (Fin.last n)) := Multiset.mem_map_of_mem _ hf
  rw [← h (Fin.last n)] at this
  obtain ⟨a, ha, hae⟩ := Multiset.mem_map.mp this
  obtain ⟨m, -, rfl⟩ := Multiset.mem_map.mp ha
  rw [← hae, ext_last]

/-- A step between padded multisets comes from a step between the original ones. -/
lemma Step.of_map_ext {d : ℕ} {Y Z : Multiset (Flow n G)} (h : Step d (Y.map ext) (Z.map ext)) :
    Step d Y Z := by
  obtain ⟨A, B, C, hY, hZ, hA, hB, hAB⟩ := h
  have hYl : ∀ f ∈ Y.map ext, f.1 (Fin.last n) = 0 := by
    intro f hf; obtain ⟨m, -, rfl⟩ := Multiset.mem_map.mp hf; exact ext_last m
  have hAl : ∀ f ∈ A, f.1 (Fin.last n) = 0 := fun f hf =>
    hYl f (by rw [hY]; exact Multiset.mem_add.mpr (Or.inl hf))
  have hCl : ∀ f ∈ C, f.1 (Fin.last n) = 0 := fun f hf =>
    hYl f (by rw [hY]; exact Multiset.mem_add.mpr (Or.inr hf))
  have eA := map_ext_map_res A hAl
  have eC := map_ext_map_res C hCl
  have hBl : ∀ f ∈ B, f.1 (Fin.last n) = 0 := by
    apply last_eq_zero_of_compatible (M := A.map res); rw [eA]; exact hAB
  have eB := map_ext_map_res B hBl
  refine ⟨A.map res, B.map res, C.map res, ?_, ?_, by simpa using hA, by simpa using hB, ?_⟩
  · apply Multiset.map_injective ext_injective
    rw [Multiset.map_add, eA, eC]; exact hY
  · apply Multiset.map_injective ext_injective
    rw [Multiset.map_add, eB, eC]; exact hZ
  · apply Compatible.of_map_ext; rw [eA, eB]; exact hAB

/-- **Monotonicity in the number of leaves**: a degree bound for `n + 1` leaves gives the same
bound for `n ≥ 1` leaves (pad every flow with a zero entry). -/
theorem GeneratedInDegree.of_succ {d : ℕ} (hn : 0 < n) (h : GeneratedInDegree (n + 1) G d) :
    GeneratedInDegree n G d := by
  intro M₁ M₂ hc
  have key : ∀ Y, Relation.ReflTransGen (Step d) (M₁.map ext) Y →
      Relation.ReflTransGen (Step d) M₁ (Y.map res) ∧ (Y.map res).map ext = Y := by
    intro Y hY
    induction hY with
    | refl => rw [map_res_map_ext]; exact ⟨Relation.ReflTransGen.refl, rfl⟩
    | tail hpath hs ih =>
      rename_i Y Z
      have hZ := map_ext_map_res Z (last_eq_zero_of_compatible
        (compatible_of_reflTransGen (hpath.tail hs)))
      refine ⟨ih.1.tail ?_, hZ⟩
      apply Step.of_map_ext
      rw [ih.2, hZ]; exact hs
  have := (key _ (h _ _ (hc.map_ext hn))).1
  rwa [map_res_map_ext] at this

open Z17

/-- First two entries of a flow on three leaves. -/
def pr (f : Flow 3 (ZMod 17)) : K := (f.1 0, f.1 1)

/-- The flow `(a, b, -a - b)`. -/
def toFlow (p : K) : Flow 3 (ZMod 17) :=
  ⟨![p.1, p.2, thd p], by simp [Fin.sum_univ_three, thd]⟩

lemma pr_toFlow (p : K) : pr (toFlow p) = p := rfl

lemma thd_pr (f : Flow 3 (ZMod 17)) : thd (pr f) = f.1 2 := by
  have h := f.2
  rw [Fin.sum_univ_three] at h
  simp only [thd, pr]
  linear_combination (-1 : ZMod 17) * h

lemma toFlow_pr (f : Flow 3 (ZMod 17)) : toFlow (pr f) = f := by
  apply Subtype.ext
  funext i
  fin_cases i
  · rfl
  · rfl
  · exact thd_pr f

/-- Table `A` as a multiset of flows. -/
def A : Multiset (Flow 3 (ZMod 17)) := PA.map toFlow

/-- Table `B` as a multiset of flows. -/
def B : Multiset (Flow 3 (ZMod 17)) := PB.map toFlow

lemma map_toFlow_col (P : Multiset K) :
    (P.map toFlow).map (fun f => f.1 0) = P.map Prod.fst ∧
    (P.map toFlow).map (fun f => f.1 1) = P.map Prod.snd ∧
    (P.map toFlow).map (fun f => f.1 2) = P.map thd := by
  refine ⟨?_, ?_, ?_⟩ <;> rw [Multiset.map_map] <;> rfl

lemma map_pr_col (M : Multiset (Flow 3 (ZMod 17))) :
    (M.map pr).map Prod.fst = M.map (fun f => f.1 0) ∧
    (M.map pr).map Prod.snd = M.map (fun f => f.1 1) ∧
    (M.map pr).map thd = M.map (fun f => f.1 2) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [Multiset.map_map]; rfl
  · rw [Multiset.map_map]; rfl
  · rw [Multiset.map_map]; exact Multiset.map_congr rfl fun f _ => thd_pr f

lemma map_toFlow_map_pr (M : Multiset (Flow 3 (ZMod 17))) : (M.map pr).map toFlow = M := by
  rw [Multiset.map_map]
  conv_rhs => rw [← Multiset.map_id M]
  exact Multiset.map_congr rfl fun f _ => toFlow_pr f

/-- The compatibility class of `A` is `{A, B}`. -/
theorem eq_A_or_B_of_compatible (M : Multiset (Flow 3 (ZMod 17))) (h : Compatible A M) :
    M = A ∨ M = B := by
  obtain ⟨a0, a1, a2⟩ := map_toFlow_col PA
  obtain ⟨m0, m1, m2⟩ := map_pr_col M
  have h1 : (M.map pr).map Prod.fst = PA.map Prod.fst := by rw [m0, ← a0]; exact (h 0).symm
  have h2 : (M.map pr).map Prod.snd = PA.map Prod.snd := by rw [m1, ← a1]; exact (h 1).symm
  have h3 : (M.map pr).map thd = PA.map thd := by rw [m2, ← a2]; exact (h 2).symm
  rcases fibre_eq _ h1 h2 h3 with e | e
  · left; rw [← map_toFlow_map_pr M, e]; rfl
  · right; rw [← map_toFlow_map_pr M, e]; rfl

set_option maxRecDepth 10000 in
lemma cols_eq : PA.map Prod.fst = PB.map Prod.fst ∧ PA.map Prod.snd = PB.map Prod.snd ∧
    PA.map thd = PB.map thd := by decide

lemma A_B_compatible : Compatible A B := by
  obtain ⟨a0, a1, a2⟩ := map_toFlow_col PA
  obtain ⟨b0, b1, b2⟩ := map_toFlow_col PB
  obtain ⟨c0, c1, c2⟩ := cols_eq
  intro i
  fin_cases i
  · exact a0.trans (c0.trans b0.symm)
  · exact a1.trans (c1.trans b1.symm)
  · exact a2.trans (c2.trans b2.symm)

set_option maxRecDepth 10000 in
lemma PA_PB_disjoint : ∀ p ∈ PA, p ∉ PB := by decide

set_option maxRecDepth 10000 in
lemma card_PA : PA.card = 18 := by decide

lemma A_ne_B : A ≠ B := by
  intro h
  have : PA = PB := by
    have h' := congrArg (Multiset.map pr) h
    simpa [A, B, Multiset.map_map, Function.comp_def, pr_toFlow] using h'
  have hmem : ((1, 3) : K) ∈ PA := by decide
  exact PA_PB_disjoint _ hmem (this ▸ hmem)

/-- From `A`, no exchange of at most 17 flows leads anywhere else. -/
lemma step_A {M' : Multiset (Flow 3 (ZMod 17))} (h : Step 17 A M') : M' = A := by
  have hc := h.compatible
  obtain ⟨A', B', C, hA, hM, hcard, -, -⟩ := h
  rcases eq_A_or_B_of_compatible M' hc with e | e
  · exact e
  · exfalso
    have hcardA : A.card = 18 := by rw [A, Multiset.card_map, card_PA]
    have hC : C ≠ 0 := by
      rintro rfl
      rw [hA, add_zero] at hcardA
      omega
    obtain ⟨c, hcC⟩ := Multiset.exists_mem_of_ne_zero hC
    have hcA : c ∈ A := by rw [hA]; exact Multiset.mem_add.mpr (Or.inr hcC)
    have hcB : c ∈ B := by rw [← e, hM]; exact Multiset.mem_add.mpr (Or.inr hcC)
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.mp hcA
    obtain ⟨q, hq, hqp⟩ := Multiset.mem_map.mp hcB
    have : q = p := by simpa [pr_toFlow] using congrArg pr hqp
    exact PA_PB_disjoint p hp (this ▸ hq)

/-- **The Sturmfels–Sullivant degree bound fails for `ℤ/17`** (counterexample of G. Pochuev):
on three leaves, the ideal of the group-based model is not generated in degree `≤ 17`. -/
theorem not_generatedInDegree_zmod17 : ¬ GeneratedInDegree 3 (ZMod 17) 17 := by
  intro h
  have hreach := h A B A_B_compatible
  have hstay : ∀ M, Relation.ReflTransGen (Step 17) A M → M = A := by
    intro M hM
    induction hM with
    | refl => rfl
    | tail _ hs ih => rw [ih] at hs; exact step_A hs
  exact A_ne_B (hstay _ hreach).symm

/-- **The degree bound fails for `ℤ/17` on every claw tree with at least three leaves.** -/
theorem not_generatedInDegree_zmod17_of_three_le :
    ∀ n : ℕ, 3 ≤ n → ¬ GeneratedInDegree n (ZMod 17) 17 := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact not_generatedInDegree_zmod17
  | succ n hn ih => exact fun h => ih (h.of_succ (by omega))

/-- In particular the universal statement of [SS05, Conjecture 29] is false. -/
theorem not_sturmfels_sullivant :
    ¬ ∀ (G : Type) [AddCommGroup G] [Fintype G] (n : ℕ), GeneratedInDegree n G (Fintype.card G) := by
  intro h
  have := h (ZMod 17) 3
  rw [ZMod.card] at this
  exact not_generatedInDegree_zmod17 this


/-! ## The surviving conjecture: constancy in the number of leaves

[Mic13, Conjecture 9.3] (M. Michałek, *Constructive degree bounds for group-based models*,
arXiv:1207.0930): "The function `φ(G, ·)` is constant."  In [MV17, Conjecture 4.3]
(arXiv:1606.07263) it reads `φ(G, n + 1) = max(2, φ(G, n))`.  The inequality
`φ(G, n) ≤ φ(G, n + 1)` is `GeneratedInDegree.of_succ` above.  The open part is the converse.
It is not affected by the `ℤ/17` counterexample, and together with the computed value
`φ(ℤ/4, 3) = 4` it would give the degree bound for `ℤ/4`. -/

/-- **Constancy conjecture** (open): for `n ≥ 3` leaves and `d ≥ 2`, a degree bound `d` for `n`
leaves gives the same bound for `n + 1` leaves. -/
def ConstancyConjecture : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Fintype G] (n d : ℕ), 3 ≤ n → 2 ≤ d →
    GeneratedInDegree n G d → GeneratedInDegree (n + 1) G d

/-- The known half, for comparison: the bound passes from `n + 1` leaves down to `n`. -/
theorem constancy_converse (G : Type) [AddCommGroup G] (n d : ℕ) (hn : 3 ≤ n) :
    GeneratedInDegree (n + 1) G d → GeneratedInDegree n G d :=
  fun h => h.of_succ (by omega)

/-- Under the constancy conjecture, a bound on three leaves propagates to every `n ≥ 3`. -/
theorem ConstancyConjecture.of_three (hC : ConstancyConjecture) (G : Type) [AddCommGroup G]
    [Fintype G] (d : ℕ) (hd : 2 ≤ d) (h3 : GeneratedInDegree 3 G d) :
    ∀ n : ℕ, 3 ≤ n → GeneratedInDegree n G d := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact h3
  | succ n hn ih => exact hC G n d hn hd ih

/-- **The open `ℤ/4` problem**: the ideal for `ℤ/4` is generated in degree `≤ 4` on every claw
tree with at least one leaf. -/
def ZMod4Conjecture : Prop := ∀ n : ℕ, 0 < n → GeneratedInDegree n (ZMod 4) 4

end SturmfelsSullivant

#print axioms SturmfelsSullivant.not_generatedInDegree_zmod17
#print axioms SturmfelsSullivant.not_sturmfels_sullivant
#print axioms SturmfelsSullivant.not_generatedInDegree_zmod17_of_three_le
#print axioms SturmfelsSullivant.GeneratedInDegree.of_succ
#print axioms SturmfelsSullivant.ConstancyConjecture.of_three
